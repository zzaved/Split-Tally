# ---------------------------------------------------------------------------
# Supabase
# Project → Settings → API. The service role key is server-only: it bypasses
# RLS and must never be exposed to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Anthropic — statement vision, categorisation, listing pricing, insights.
# Server-side only (BUILD.MD §7).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# ElevenLabs — the orb.
# AGENT_ID is public because the browser opens the WebRTC session with it.
# The API key stays server-side and is used to mint signed session URLs and to
# render the four voice samples on /onboarding/voice.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# The four voices offered at onboarding (BUILD.MD §5.2). Any ElevenLabs voice
# id works; these names are what the UI shows.
NEXT_PUBLIC_ELEVENLABS_VOICE_COBALT=
NEXT_PUBLIC_ELEVENLABS_VOICE_INDIGO=
NEXT_PUBLIC_ELEVENLABS_VOICE_ULTRAMARINE=
NEXT_PUBLIC_ELEVENLABS_VOICE_CERULEAN=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The one-click "Explore the demo" account seeded by supabase/seed.sql.
DEMO_EMAIL=demo@splittally.app
DEMO_PASSWORD=tallystick2026
